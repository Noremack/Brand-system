/* --- MODULE CONTRACT: 08-cleanup-protocol.jsxinc ---
Purpose: Safe document sanitization engine wiping custom styles, swatches, and master items while protecting user text and document structure.
Public entry points: CleanupProtocol (resetDocument).
Inputs: Target InDesign Document reference.
Outputs: None.
Required dependencies: 02-utilities.jsxinc.
Side effects: Destructively resets custom styles, groups, swatches, and master page items to InDesign defaults.
Compatibility: ExtendScript ES3 (Adobe InDesign CS6 through CC 2026+).
-------------------------------------------------- */

/**
 * @file 08-cleanup-protocol.jsxinc
 * @package InDesign Brand System — Queensland Government Design System (QGDS)
 * @version 2.4.0
 * @author Queensland Government Publishing & Design Engineering
 * @description Safe document sanitization engine. Wipes all Brand System custom
 * styles, swatches, and master page decorations while protecting user text and
 * document structure, restoring InDesign default styling.
 *
 * Sanitization Sequence:
 * 1. Layer Unlock: Unlocks all document layers to ensure deletion operations succeed.
 * 2. Master Page Items: Purges placed decorations from "A-Cover", "B-Content", "C-Back".
 * 3. Text Frame Reset: Reassigns frame text to [Basic Paragraph] and clears overrides
 *    to prevent cascading style deletion exceptions.
 * 4. Style Sweeps: Removes custom paragraph, character, object, table, and cell styles.
 * 5. Style Groups: Purges empty style folders and groups.
 * 6. Swatch Cleanup: Deletes custom brand swatches while strictly preserving InDesign
 *    built-ins ([None], [Registration], [Paper], [Black]).
 */


var CleanupProtocol = {
    /**
     * Resets the active document by wiping all brand styles, swatches, and master items.
     * @param {Document} doc - The active InDesign document to sanitize.
     * @returns {void}
     */
    resetDocument: function(doc) {
        // ---------------------------------------------------------------------
        // 1. UNLOCK ALL LAYERS
        // ---------------------------------------------------------------------
        var docLayers = doc.layers.everyItem().getElements();
        for (var l = 0; l < docLayers.length; l++) {
            if (docLayers[l].isValid && docLayers[l].locked) {
                try {
                    docLayers[l].locked = false;
                } catch (e) {
                    Logger.warn("Failed to unlock layer '" + docLayers[l].name + "': " + e.message);
                }
            }
        }

        // ---------------------------------------------------------------------
        // 2. CLEAR MASTER PAGE DECORATIONS
        // ---------------------------------------------------------------------
        var masters = doc.masterSpreads.everyItem().getElements();
        for (var m = 0; m < masters.length; m++) {
            var master = masters[m];
            if (!master.isValid) continue;

            var isTargetMaster = (master.namePrefix === "A" && master.baseName === "Cover") ||
                                 (master.namePrefix === "B" && master.baseName === "Content") ||
                                 (master.namePrefix === "C" && master.baseName === "Back");

            if (isTargetMaster) {
                var items = master.allPageItems;
                if (items.length > 0) {
                    Logger.info("Reset: Clearing " + items.length + " items from master page '" + master.name + "'");
                    for (var j = items.length - 1; j >= 0; j--) {
                        var item = items[j];
                        if (item.isValid) {
                            try {
                                if (item.itemLayer && item.itemLayer.isValid && item.itemLayer.locked) {
                                    item.itemLayer.locked = false;
                                }
                                if (item.locked) item.locked = false;
                                item.remove();
                            } catch (e) {
                                Logger.warn("Failed to delete item from master " + master.name + ": " + e.message);
                            }
                        }
                    }
                }
            }
        }

        // ---------------------------------------------------------------------
        // 3. REASSIGN TEXT FRAMES TO IN-DESIGN DEFAULTS
        // ---------------------------------------------------------------------
        var frames = doc.textFrames.everyItem().getElements();
        for (var i = 0; i < frames.length; i++) {
            if (frames[i].isValid && frames[i].texts.length > 0) {
                try {
                    frames[i].texts[0].appliedParagraphStyle = doc.paragraphStyles.itemByName("[Basic Paragraph]");
                    frames[i].texts[0].clearOverrides(OverrideType.ALL);
                    frames[i].texts[0].appliedCharacterStyle = doc.characterStyles.itemByName("[None]");
                } catch (e) {
                    Logger.warn("Failed to reset frame text: " + e.message);
                }
            }
        }

        // ---------------------------------------------------------------------
        // 4. PURGE CUSTOM STYLES (Bottom-up traversal)
        // ---------------------------------------------------------------------
        var pStyles = doc.paragraphStyles.everyItem().getElements();
        for (var p = pStyles.length - 1; p >= 0; p--) {
            if (pStyles[p].isValid && pStyles[p].name !== "[No Paragraph Style]" && pStyles[p].name !== "[Basic Paragraph]") {
                try {
                    pStyles[p].remove();
                } catch (e) {
                    Logger.warn("Failed to remove pStyle " + pStyles[p].name + ": " + e.message);
                }
            }
        }

        var cStyles = doc.characterStyles.everyItem().getElements();
        for (var c = cStyles.length - 1; c >= 0; c--) {
            if (cStyles[c].isValid && cStyles[c].name !== "[None]") {
                try {
                    cStyles[c].remove();
                } catch (e) {
                    Logger.warn("Failed to remove cStyle " + cStyles[c].name + ": " + e.message);
                }
            }
        }

        var oStyles = doc.objectStyles.everyItem().getElements();
        for (var o = oStyles.length - 1; o >= 0; o--) {
            if (oStyles[o].isValid && oStyles[o].name !== "[None]" && oStyles[o].name !== "Artifact frame" && oStyles[o].name !== "[Basic Grid]" && oStyles[o].name !== "[Basic Text Frame]") {
                try {
                    oStyles[o].remove();
                } catch (e) {
                    Logger.warn("Failed to remove oStyle " + oStyles[o].name + ": " + e.message);
                }
            }
        }

        var tStyles = doc.tableStyles.everyItem().getElements();
        for (var t = tStyles.length - 1; t >= 0; t--) {
            if (tStyles[t].isValid && tStyles[t].name !== "[Basic Table]" && tStyles[t].name !== "[No Table Style]") {
                try {
                    tStyles[t].remove();
                } catch (e) {
                    Logger.warn("Failed to remove tStyle " + tStyles[t].name + ": " + e.message);
                }
            }
        }

        var cellStyles = doc.cellStyles.everyItem().getElements();
        for (var cs = cellStyles.length - 1; cs >= 0; cs--) {
            if (cellStyles[cs].isValid && cellStyles[cs].name !== "[None]") {
                try {
                    cellStyles[cs].remove();
                } catch (e) {
                    Logger.warn("Failed to remove cellStyle " + cellStyles[cs].name + ": " + e.message);
                }
            }
        }

        // ---------------------------------------------------------------------
        // 5. PURGE EMPTY STYLE GROUPS
        // ---------------------------------------------------------------------
        var oGroups = doc.objectStyleGroups.everyItem().getElements();
        for (var og = oGroups.length - 1; og >= 0; og--) {
            try { if (oGroups[og].isValid) oGroups[og].remove(); } catch (e) { Logger.warn("Failed to remove oGroup: " + e.message); }
        }

        var pGroups = doc.paragraphStyleGroups.everyItem().getElements();
        for (var pg = pGroups.length - 1; pg >= 0; pg--) {
            try { if (pGroups[pg].isValid) pGroups[pg].remove(); } catch (e) { Logger.warn("Failed to remove pGroup: " + e.message); }
        }

        var cGroups = doc.characterStyleGroups.everyItem().getElements();
        for (var cg = cGroups.length - 1; cg >= 0; cg--) {
            try { if (cGroups[cg].isValid) cGroups[cg].remove(); } catch (e) { Logger.warn("Failed to remove cGroup: " + e.message); }
        }

        var tGroups = doc.tableStyleGroups.everyItem().getElements();
        for (var tg = tGroups.length - 1; tg >= 0; tg--) {
            try { if (tGroups[tg].isValid) tGroups[tg].remove(); } catch (e) { Logger.warn("Failed to remove tGroup: " + e.message); }
        }

        var cellGroups = doc.cellStyleGroups.everyItem().getElements();
        for (var csg = cellGroups.length - 1; csg >= 0; csg--) {
            try { if (cellGroups[csg].isValid) cellGroups[csg].remove(); } catch (e) { Logger.warn("Failed to remove cellGroup: " + e.message); }
        }

        // ---------------------------------------------------------------------
        // 6. PURGE CUSTOM BRAND SWATCHES
        // ---------------------------------------------------------------------
        var keepSwatches = ["[None]", "[Registration]", "[Paper]", "[Black]", "None", "Registration", "Paper", "Black"];
        var swatches = doc.swatches.everyItem().getElements();
        for (var k = swatches.length - 1; k >= 0; k--) {
            if (!swatches[k].isValid) continue;
            var removeSwatch = true;
            for (var m = 0; m < keepSwatches.length; m++) {
                if (swatches[k].name === keepSwatches[m]) {
                    removeSwatch = false;
                    break;
                }
            }
            if (swatches[k].name.indexOf("BA") === 0) removeSwatch = false;
            if (removeSwatch) {
                try {
                    swatches[k].remove();
                } catch (e) {
                    Logger.warn("Failed to remove swatch " + swatches[k].name + ": " + e.message);
                }
            }
        }
    }
};