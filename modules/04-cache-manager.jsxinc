/* --- MODULE CONTRACT: 04-cache-manager.jsxinc ---
Purpose: In-memory DOM element caching layer for swatches, styles, strokes, and lists to eliminate O(N) DOM queries.
Public entry points: CacheManager (getSwatch, getPStyle, getCStyle, getCellStyle, getStrokeStyle, getList, reset).
Inputs: InDesign Document reference, style and swatch name strings.
Outputs: Cached InDesign DOM objects (Swatch, ParagraphStyle, CharacterStyle, CellStyle, StrokeStyle, NumberingList).
Required dependencies: None.
Side effects: Retains live InDesign DOM references in memory during script execution.
Compatibility: ExtendScript ES3 (Adobe InDesign CS6 through CC 2026+).
-------------------------------------------------- */

/**
 * @file 04-cache-manager.jsxinc
 * @package InDesign Brand System — Queensland Government Design System (QGDS)
 * @version 2.4.0
 * @author Queensland Government Publishing & Design Engineering
 * @description In-memory DOM element caching layer. Caches swatches, paragraph
 * styles, character styles, cell styles, stroke styles, and numbering lists
 * to eliminate repeated O(N) InDesign DOM traversals.
 *
 * Why In-Memory Caching?
 * Querying InDesign DOM collections (e.g., doc.paragraphStyles.itemByName() or
 * doc.swatches.itemByName()) crosses the ExtendScript C++ boundary and is
 * notoriously slow. When generating or inspecting hundreds of styles, caching
 * resolved DOM objects in a RAM dictionary yields a 10x–50x speed improvement.
 */


var CacheManager = {
    /**
     * Swatch cache dictionary keyed by swatch name.
     * @type {Object}
     */
    swatches: {},

    /**
     * Paragraph style cache dictionary keyed by style name.
     * @type {Object}
     */
    pStyles: {},

    /**
     * Character style cache dictionary keyed by style name.
     * @type {Object}
     */
    cStyles: {},

    /**
     * Cell style cache dictionary keyed by style name.
     * @type {Object}
     */
    cellStyles: {},

    /**
     * Stroke style cache dictionary keyed by style name.
     * @type {Object}
     */
    strokeStyles: {},

    /**
     * Numbering list cache dictionary keyed by list name.
     * @type {Object}
     */
    lists: {},

    /**
     * Retrieves a swatch by name, checking memory cache first before querying the DOM.
     * @param {Document} doc - The active InDesign document.
     * @param {String} name - Name of the swatch.
     * @returns {Swatch|null} The resolved swatch or null.
     */
    getSwatch: function(doc, name) {
        if (this.swatches[name]) return this.swatches[name];
        var item = doc.swatches.itemByName(name);
        if (item.isValid) {
            this.swatches[name] = item;
            return item;
        }
        return null;
    },

    /**
     * Retrieves a paragraph style by name, checking memory cache first.
     * If itemByName fails, performs an exhaustive scan of doc.allParagraphStyles.
     * @param {Document} doc - The active InDesign document.
     * @param {String} name - Name of the paragraph style.
     * @returns {ParagraphStyle|null} The resolved paragraph style or null.
     */
    getPStyle: function(doc, name) {
        if (this.pStyles[name]) return this.pStyles[name];
        var item = doc.paragraphStyles.itemByName(name);
        if (item.isValid) {
            this.pStyles[name] = item;
            return item;
        }
        var all = doc.allParagraphStyles;
        for (var i = 0; i < all.length; i++) {
            if (all[i].name === name) {
                this.pStyles[name] = all[i];
                return all[i];
            }
        }
        return null;
    },

    /**
     * Retrieves a character style by name, checking memory cache first.
     * If itemByName fails, performs an exhaustive scan of doc.allCharacterStyles.
     * @param {Document} doc - The active InDesign document.
     * @param {String} name - Name of the character style.
     * @returns {CharacterStyle|null} The resolved character style or null.
     */
    getCStyle: function(doc, name) {
        if (this.cStyles[name]) return this.cStyles[name];
        var item = doc.characterStyles.itemByName(name);
        if (item.isValid) {
            this.cStyles[name] = item;
            return item;
        }
        var all = doc.allCharacterStyles;
        for (var i = 0; i < all.length; i++) {
            if (all[i].name === name) {
                this.cStyles[name] = all[i];
                return all[i];
            }
        }
        return null;
    },

    /**
     * Retrieves a table cell style by name, checking memory cache first.
     * @param {Document} doc - The active InDesign document.
     * @param {String} name - Name of the cell style.
     * @returns {CellStyle|null} The resolved cell style or null.
     */
    getCellStyle: function(doc, name) {
        if (this.cellStyles[name]) return this.cellStyles[name];
        var item = doc.cellStyles.itemByName(name);
        if (item.isValid) {
            this.cellStyles[name] = item;
            return item;
        }
        var all = doc.allCellStyles;
        for (var i = 0; i < all.length; i++) {
            if (all[i].name === name) {
                this.cellStyles[name] = all[i];
                return all[i];
            }
        }
        return null;
    },

    /**
     * Retrieves a stroke style by name, checking memory cache first.
     * @param {Document} doc - The active InDesign document.
     * @param {String} name - Name of the stroke style.
     * @returns {StrokeStyle|null} The resolved stroke style or null.
     */
    getStrokeStyle: function(doc, name) {
        if (this.strokeStyles[name]) return this.strokeStyles[name];
        var item = doc.strokeStyles.itemByName(name);
        if (item.isValid) {
            this.strokeStyles[name] = item;
            return item;
        }
        return null;
    },

    /**
     * Retrieves or creates a NumberingList by name, checking memory cache first.
     * @param {Document} doc - The active InDesign document.
     * @param {String} name - Name of the numbering list.
     * @returns {NumberingList} The resolved or newly created numbering list.
     */
    getList: function(doc, name) {
        if (this.lists[name]) return this.lists[name];
        var item = doc.numberingLists.itemByName(name);
        if (!item.isValid) {
            item = doc.numberingLists.add({ name: name });
        }
        this.lists[name] = item;
        return item;
    },

    /**
     * Wipes all cached DOM object references from memory.
     * @returns {void}
     */
    reset: function() {
        this.swatches = {};
        this.pStyles = {};
        this.cStyles = {};
        this.cellStyles = {};
        this.strokeStyles = {};
        this.lists = {};
    }
};
