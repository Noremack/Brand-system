/* --- MODULE CONTRACT: 03-token-loader.jsxinc ---
Purpose: Multi-tiered JSON design token loader resolving and parsing brand-tokens.json across project and system directories.
Public entry points: loadBrandTokens, findBrandTokensFile, resolveUiColor.
Inputs: Active InDesign Document reference, filesystem paths.
Outputs: Hydrated runtime config dictionary.
Required dependencies: 01-config.jsxinc, 02-utilities.jsxinc.
Side effects: Mutates the global config object by hydrating all token properties.
Compatibility: ExtendScript ES3 (Adobe InDesign CS6 through CC 2026+).
-------------------------------------------------- */

/**
 * @file 03-token-loader.jsxinc
 * @package InDesign Brand System — Queensland Government Design System (QGDS)
 * @version 2.4.0
 * @author Queensland Government Publishing & Design Engineering
 * @description Multi-tiered JSON design token loader. Searches for and parses
 * brand-tokens.json across project document folders, script directories, and
 * host application support folders, hydrating the runtime config dictionary.
 *
 * Search Hierarchy:
 * 1. Active Document Directory: Per-project token override (docFolder/brand-tokens.json).
 * 2. Script Bundle Directory: Parent and grandparent folders of the active script.
 * 3. InDesign AppData / Scripts Panel: Version-specific user scripting directories.
 * 4. Embedded Fallback: In standalone bundle builds, hydrates from __EMBEDDED_BRAND_TOKENS__.
 */


/**
 * Searches for brand-tokens.json across multi-tiered directory hierarchy:
 * 1. Document directory (per-project override)
 * 2. Script bundle root directory
 * 3. Standard InDesign Scripts Panel / AppData directories
 *
 * @param {Document} [doc] - Optional active document reference for project-level overrides.
 * @returns {File|null} File handle if found, or null.
 */
function findBrandTokensFile(doc) {
    // 1. Check document folder (Project-level override)
    if (doc) {
        var docFolder = "";
        try {
            if (doc.saved) {
                if (doc.filePath) docFolder = doc.filePath.fsName || doc.filePath;
                else if (doc.fullName && doc.fullName.parent) docFolder = doc.fullName.parent.fsName;
            }
        } catch (_) {}
        if (docFolder) {
            var docFile = new File(docFolder + "/brand-tokens.json");
            if (docFile.exists) return docFile;
        }
    }

    // 2. Check current script root directory
    var scriptPath = (typeof $ !== "undefined" && $.fileName) ? $.fileName : "";
    if (scriptPath) {
        var scriptFile = new File(scriptPath);
        var dir1 = scriptFile.parent ? scriptFile.parent.fsName : "";
        var dir2 = (scriptFile.parent && scriptFile.parent.parent) ? scriptFile.parent.parent.fsName : "";
        var dir3 = (scriptFile.parent && scriptFile.parent.parent && scriptFile.parent.parent.parent) ? scriptFile.parent.parent.parent.fsName : "";

        if (dir3) {
            var f3 = new File(dir3 + "/brand-tokens.json");
            if (f3.exists) return f3;
        }
        if (dir2) {
            var f2 = new File(dir2 + "/brand-tokens.json");
            if (f2.exists) return f2;
        }
        if (dir1) {
            var f1 = new File(dir1 + "/brand-tokens.json");
            if (f1.exists) return f1;
        }
    }

    // 3. Fallback search in standard InDesign Scripts Panel directories
    var appData = "";
    try {
        if (typeof Folder !== "undefined" && Folder.appData) {
            appData = Folder.appData.fsName;
        }
    } catch (_) {}
    if (appData) {
        var panelCandidates = [
            appData + "/Adobe/InDesign/Version 21.0/en_US/Scripts/Scripts Panel/InDesign Brand System/brand-tokens.json",
            appData + "/Adobe/InDesign/Version 20.0/en_US/Scripts/Scripts Panel/InDesign Brand System/brand-tokens.json",
            appData + "/Adobe/InDesign/Version 19.0/en_US/Scripts/Scripts Panel/InDesign Brand System/brand-tokens.json"
        ];
        for (var p = 0; p < panelCandidates.length; p++) {
            var cand = new File(panelCandidates[p]);
            if (cand.exists) return cand;
        }
    }

    return null;
}

/**
 * Resolves an InDesign UIColors enum value safely from a token string name.
 * @param {String} colorName - Name of the color (e.g. "BLUE", "RED", "GRAY").
 * @returns {UIColors} Corresponding UIColors enum value or UIColors.BLUE fallback.
 */
function resolveUiColor(colorName) {
    if (typeof UIColors === "undefined") return colorName;
    if (!colorName || typeof colorName !== "string") return UIColors.BLUE;
    var upper = colorName.toUpperCase();
    if (UIColors[upper] !== undefined) return UIColors[upper];
    return UIColors.BLUE;
}

/**
 * Reads and applies tokens from brand-tokens.json into the global config object.
 * In standalone bundle mode, falls back to build-time __EMBEDDED_BRAND_TOKENS__.
 *
 * @param {Document} [doc] - Optional active document reference.
 * @returns {Boolean} True if tokens were successfully resolved and loaded, false otherwise.
 */
function loadBrandTokens(doc) {
    var tokensFile = findBrandTokensFile(doc);
    var json = null;
    var sourceName = "unloaded";

    if (tokensFile && tokensFile.exists) {
        var content = "";
        try {
            tokensFile.open("r");
            content = tokensFile.read();
            tokensFile.close();
        } catch (err) {
            if (typeof Logger !== "undefined") Logger.warn("Failed to read brand-tokens.json: " + err.message);
        }

        if (content) {
            try {
                if (typeof JSON !== "undefined" && JSON.parse) {
                    json = JSON.parse(content);
                } else {
                    json = eval("(" + content + ")");
                }
                sourceName = tokensFile.fsName;
            } catch (parseErr) {
                if (typeof Logger !== "undefined") Logger.warn("Failed to parse brand-tokens.json: " + parseErr.message);
                json = null;
            }
        }
    }

    // Fall back to standalone bundle embedded payload if external file was not resolved
    if (!json && typeof __EMBEDDED_BRAND_TOKENS__ !== "undefined" && __EMBEDDED_BRAND_TOKENS__) {
        json = __EMBEDDED_BRAND_TOKENS__;
        sourceName = "embedded-tokens";
    }

    if (!json || typeof json !== "object") {
        config.source = "unloaded";
        return false;
    }

    // Merge loaded tokens into global config
    if (json.PT_TO_MM) {
        config.PT_TO_MM = json.PT_TO_MM;
    }
    if (json.pageMatrix && json.pageMatrix.length > 0) {
        config.pageMatrix = json.pageMatrix;
    }
    if (json.fallbackMetrics) {
        config.fallbackMetrics = json.fallbackMetrics;
    }
    if (json.dialogDefaults) {
        config.dialogDefaults = json.dialogDefaults;
    }
    if (json.typographyMatrix) {
        config.typographyMatrix = json.typographyMatrix;
    }
    if (json.designTokens) {
        config.designTokens = json.designTokens;
    }
    if (json.specimenStyles && json.specimenStyles.length > 0) {
        config.specimenStyles = json.specimenStyles;
    }
    if (json.availableThemes && json.availableThemes.length > 0) {
        config.availableThemes = json.availableThemes;
    }
    if (json.colors && json.colors.length > 0) {
        config.colors = json.colors;
    }
    if (json.gradients && json.gradients.length > 0) {
        config.gradients = json.gradients;
    }
    if (json.styles) {
        config.styles = json.styles;
    }

    // Resolve Layer Colors
    if (json.layerMatrix && json.layerMatrix.length > 0) {
        var lm = [];
        for (var i = 0; i < json.layerMatrix.length; i++) {
            var item = json.layerMatrix[i];
            lm.push({
                name: item.name,
                color: resolveUiColor(item.color),
                aliases: item.aliases || []
            });
        }
        config.layerMatrix = lm;
    }

    // Resolve Asset Tokens
    if (json.assetTokens) {
        var scriptDir = (typeof $ !== "undefined" && $.fileName) ? new File($.fileName).parent.parent.fsName : "";
        var relDir = json.assetTokens.footerRelativeDirectory || "Resources/Footers/EPS/";
        config.assetTokens = {
            footerDirectory: scriptDir ? (scriptDir + "/" + relDir) : (config.assetTokens ? config.assetTokens.footerDirectory : ""),
            footerVariants: json.assetTokens.footerVariants || ["Q", "Q-QR", "BA", "BA-QR", "DRFA"],
            textureAlignment: json.assetTokens.textureAlignment || "TOP_CENTER_ANCHOR",
            textureAlignmentSmall: json.assetTokens.textureAlignmentSmall || "TOP_CENTER_ANCHOR",
            textureAlignmentMedium: json.assetTokens.textureAlignmentMedium || "TOP_CENTER_ANCHOR"
        };
    }

    config.source = sourceName;
    return true;
}

// Bind loader methods to config object for backward-compatibility
config.load = function(doc) {
    return loadBrandTokens(doc);
};

config.reload = function(doc) {
    return loadBrandTokens(doc);
};

// Automatically execute token load on module initialization
try {
    var activeDoc = (typeof app !== "undefined" && app.documents && app.documents.length > 0) ? app.activeDocument : null;
    loadBrandTokens(activeDoc);
} catch (_) {}
